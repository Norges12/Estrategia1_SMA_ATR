# ====== Telegram ======
# Token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAEexampleTokenAAA

# IDs de Telegram permitidos (separados por coma). Obten el tuyo escribiendo a @userinfobot
ALLOWED_USER_IDS=111111111,222222222

# ====== Microsoft Graph (Azure App Registration) ======
# Crea una App en https://portal.azure.com -> Azure Active Directory -> App registrations
# Tipo: "Public client / native"  -> Redirect URI: http://localhost
# Permisos delegados: Files.ReadWrite, User.Read (otorga consentimiento)
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Para cuentas personales (Hotmail/Outlook/Live) usa "consumers"
# Para cuentas de trabajo/escuela usa "organizations" o tu Tenant ID
# Para ambos usa "common"
MS_TENANT_ID=consumers

# ====== Excel ======
# Ruta del archivo dentro de tu OneDrive (sin la barra inicial)
EXCEL_FILE_PATH=Documentos/datos.xlsx

# Nombre de la Tabla dentro del Excel (selecciona el rango y crea Tabla con Ctrl+T)
EXCEL_TABLE_NAME=Tabla1

# Nombre de la Hoja (worksheet) que contiene la tabla
EXCEL_WORKSHEET=Hoja1
