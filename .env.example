# ====== Telegram ======
TELEGRAM_BOT_TOKEN=123456789:AAEexampleTokenAAA
# Tu user_id (sacalo hablando con @userinfobot). Varios separados por coma.
ALLOWED_USER_IDS=111111111

# ====== Microsoft Graph (Azure App Registration) ======
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "consumers" para Hotmail/Outlook/Live, "common" para mixto, "organizations" o tu Tenant ID para trabajo.
MS_TENANT_ID=consumers

# ====== Excel ======
# Ruta del archivo dentro de OneDrive (sin barra inicial, con .xlsx)
EXCEL_FILE_PATH=Documentos/Regist Gan 2026.xlsx

# Nombres exactos de las 4 tablas (los que ves en "Diseño de tabla")
EXCEL_TABLE_1=Tabla1
EXCEL_TABLE_2=Tabla13
EXCEL_TABLE_3=Tabla14
EXCEL_TABLE_4=Tabla15

# Tabla por defecto cuando mandás texto sin comando (1..4)
EXCEL_TABLE_DEFAULT=1
